<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(LatestDotNet)</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <AssemblyName>SDL2.Core.CompileCheck</AssemblyName>
    <RootNamespace>Janset.SDL2.CompileCheck</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAOTAnalyzer>false</EnableAOTAnalyzer>
    <GeneratedBindingsPreviewRoot Condition="'$(GeneratedBindingsPreviewRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\generated-bindings-preview\sdl2-core\</GeneratedBindingsPreviewRoot>
  </PropertyGroup>

  <ItemGroup>
    <GeneratedBindingCompileInput Include="$(GeneratedBindingsPreviewRoot)**\*.g.cs" />
    <Compile Include="@(GeneratedBindingCompileInput)" />
  </ItemGroup>

  <Target Name="EnsureGeneratedBindingCompileInputs" BeforeTargets="CoreCompile">
    <Error
      Condition="'@(GeneratedBindingCompileInput)' == ''"
      Text="BINDING-COMPILE-CHECK-001: SDL2.Core compile-check found no generated binding .g.cs files under '$(GeneratedBindingsPreviewRoot)'. Run 'dotnet run --file tools.cs -- generate-bindings' before building this project." />
  </Target>
</Project>
