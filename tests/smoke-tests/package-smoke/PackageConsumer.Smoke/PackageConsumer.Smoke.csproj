<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Consumer-side TUnit smoke. Feeds + versions + guards come from
    build/msbuild/Janset.Smoke.{props,targets} via tests/smoke-tests/Directory.Build.{props,targets}.
    Values arrive either through Janset.Local.props (written by the repo-root `tools setup`
    script, IDE/direct build path) or through Cake's PackageConsumerSmokeRunner.
  -->
  <PropertyGroup>
    <!--
      TUnit test project. Microsoft Testing Platform produces an apphost per TFM,
      so OutputType=Exe is correct. Multi-TFM coverage from centralized
      $(ExecutableTargetFrameworks) — see root Directory.Build.props.
    -->
    <TargetFrameworks>$(ExecutableTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <IsPackable>false</IsPackable>

    <!--
      Smoke family declaration. Janset.Smoke.targets expands this list into exact-pinned
      PackageReference entries. Set the property to one or more semicolon-delimited family
      roles (e.g. Core;Image;Mixer;Ttf;Gfx for a full SDL2 consumer).
    -->
    <JansetSmokeSdl2Families>Core;Image;Mixer;Ttf;Gfx</JansetSmokeSdl2Families>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />

  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\assets\janset2d-sdl-min.png" Link="TestAssets\janset2d-sdl-min.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
