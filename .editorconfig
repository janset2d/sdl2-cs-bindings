dotnet_diagnostic.VSTHRD110.severity = error
# QM-10: VSTHRD111 stays at none until "style: ConfigureAwait required in libraries, removed from the build host and tools".
dotnet_diagnostic.VSTHRD111.severity = none
dotnet_diagnostic.VSTHRD114.severity = error
dotnet_diagnostic.VSTHRD200.severity = suggestion

# SECTION 10: MEZIANTOU
MA0051.maximum_lines_per_method = 80
MA0051.maximum_statements_per_method = 60
MA0011.exclude_tostring_methods = true
MA0004.report = Always
# Virtual members mark inheritance-by-design, so only the public-class option is enabled.
MA0053.public_class_should_be_sealed = true
dotnet_diagnostic.MA0001.severity = error
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0011.severity = error
dotnet_diagnostic.MA0074.severity = error
dotnet_diagnostic.MA0075.severity = error
# QM-20: MA0076 stays at suggestion until "style: remaining revived rules".
dotnet_diagnostic.MA0076.severity = suggestion
# Async analyzers retain overlapping coverage of Task and ValueTask operations.
# QM-10: MA0004 stays at none until "style: ConfigureAwait required in libraries, removed from the build host and tools".
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0022.severity = error
# QM-20: MA0042 stays at suggestion until "style: remaining revived rules".
dotnet_diagnostic.MA0042.severity = suggestion
dotnet_diagnostic.MA0045.severity = error
