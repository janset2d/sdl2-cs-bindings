dotnet_diagnostic.MA0193.severity = suggestion
dotnet_diagnostic.MA0194.severity = suggestion
dotnet_diagnostic.MA0195.severity = error
dotnet_diagnostic.MA0196.severity = error
# CS1591 owns the shipped-surface documentation policy.
dotnet_diagnostic.MA0197.severity = none
dotnet_diagnostic.MA0198.severity = error
dotnet_diagnostic.MA0199.severity = error
dotnet_diagnostic.MA0200.severity = suggestion
dotnet_diagnostic.MA0201.severity = error
dotnet_diagnostic.MA0202.severity = error
dotnet_diagnostic.MA0203.severity = error

# SECTION 11: ROSLYNATOR
# IDE2003 owns blank lines after statement blocks.
dotnet_diagnostic.RCS0008.severity = none
# IDE0011 owns braces on every control-flow body.
dotnet_diagnostic.RCS1007.severity = none
dotnet_diagnostic.RCS1214.severity = error
dotnet_diagnostic.RCS1181.severity = error
dotnet_diagnostic.RCS1140.severity = suggestion
dotnet_diagnostic.RCS1141.severity = suggestion
roslynator_max_line_length = 180
dotnet_diagnostic.RCS0054.severity = error
dotnet_diagnostic.RCS0056.severity = error

# REPOSITORY ANALYZERS
dotnet_diagnostic.JNS0001.severity = error
dotnet_diagnostic.JNS0002.severity = error

# SECTION 12: SONAR
# IDE0011 owns braces on every control-flow body.
dotnet_diagnostic.S121.severity = none
# Unlisted rules use SonarWay defaults, escalated by TreatWarningsAsErrors.
dotnet_diagnostic.S125.severity = suggestion
dotnet_diagnostic.S2094.severity = suggestion
dotnet_diagnostic.S2437.severity = error
dotnet_diagnostic.S2479.severity = suggestion
# Exception serialization is obsolete on modern .NET.
dotnet_diagnostic.S3925.severity = none
dotnet_diagnostic.S1118.severity = error
dotnet_diagnostic.S3963.severity = error
dotnet_diagnostic.S4457.severity = suggestion
# Preserve the existing LINQ-based lookup convention.
dotnet_diagnostic.S6602.severity = none

# SECTION 13: COMPILER
# Only the shipped library surface is documented.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1570.severity = error
dotnet_diagnostic.CS1572.severity = error
dotnet_diagnostic.CS1573.severity = error
dotnet_diagnostic.CS1574.severity = error
dotnet_diagnostic.CS1587.severity = error

# Hand-written shipped library code documents every public member.
[src/SDL2.*/**.cs]
dotnet_diagnostic.CS1591.severity = error

# SECTION 14: GENERATED CODE
# Generated bindings retain their compiler, oracle, snapshot, ABI and drift gates.
[**/Generated/**.g.cs]
generated_code = true

[*.{g.cs,generated.cs,designer.cs}]
generated_code = true

# Vendored bindings keep their existing analyzer exclusion.
[external/sdl2-cs/src/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA5392.severity = none

# SECTION 15: TEST OVERRIDES
[{build/_build.Tests,build/analyzers/*.Tests,tests,spikes/binding-generators/clangsharp/tests}/**.cs]
# Test method names use underscores and their public surface is not shipped.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none
# TUnit assertion awaitables are not modeled by this analyzer.
dotnet_diagnostic.MA0042.severity = none
# Tests have no SynchronizationContext to preserve.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.VSTHRD111.severity = none

# Test namespaces are not a consumer-facing API.
dotnet_diagnostic.CA1716.severity = none

# FILE-SCOPED ARBITRATION
# Duplicate detection mutates the version map; filtering would hide that mutation in a predicate.
# Winner: explicit stateful validation; S3267 remains enabled for every other file.
[build/_build/Data/Versions/PackageFamilyVersionSet.cs]
dotnet_diagnostic.S3267.severity = none

# Git has no fixed install path across supported hosts; PATH selects it and --repo-root bypasses it.
# Winner: pre-Cake repository discovery; S4036 remains enabled for every other file.
