dotnet_diagnostic.MA0052.severity = error
dotnet_diagnostic.MA0053.severity = error
dotnet_diagnostic.MA0067.severity = error
dotnet_diagnostic.MA0102.severity = error
dotnet_diagnostic.MA0110.severity = error
# CA rules own these duplicate checks.
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0180.severity = suggestion
# Explicit casts make native ABI conversions visible.
dotnet_diagnostic.MA0181.severity = none
dotnet_diagnostic.MA0182.severity = suggestion
dotnet_diagnostic.MA0183.severity = error
dotnet_diagnostic.MA0184.severity = error
dotnet_diagnostic.MA0185.severity = error
dotnet_diagnostic.MA0186.severity = suggestion
# This repository has no Blazor component injection.
dotnet_diagnostic.MA0187.severity = none
dotnet_diagnostic.MA0188.severity = suggestion
dotnet_diagnostic.MA0189.severity = suggestion
dotnet_diagnostic.MA0190.severity = suggestion
dotnet_diagnostic.MA0191.severity = suggestion
