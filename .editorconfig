dotnet_diagnostic.MA0203.severity = error

# SECTION 11: ROSLYNATOR
dotnet_diagnostic.RCS1214.severity = error
# QM-11: RCS1181 stays at suggestion until "style: collection expressions, sealing, and the remaining revived rules".
dotnet_diagnostic.RCS1181.severity = suggestion
dotnet_diagnostic.RCS1140.severity = suggestion
dotnet_diagnostic.RCS1141.severity = suggestion
roslynator_max_line_length = 180
dotnet_diagnostic.RCS0054.severity = error
# QM-5: RCS0056 stays at suggestion until "style: wrap lines over 180 characters (RCS0056 error)".
dotnet_diagnostic.RCS0056.severity = suggestion

# SECTION 12: SONAR
# Unlisted rules use SonarWay defaults, escalated by TreatWarningsAsErrors.
dotnet_diagnostic.S125.severity = suggestion
dotnet_diagnostic.S2094.severity = suggestion
dotnet_diagnostic.S2437.severity = error
dotnet_diagnostic.S2479.severity = suggestion
# Exception serialization is obsolete on modern .NET.
dotnet_diagnostic.S3925.severity = none
dotnet_diagnostic.S1118.severity = error
dotnet_diagnostic.S3963.severity = error
dotnet_diagnostic.S4457.severity = suggestion
# Preserve the existing LINQ-based lookup convention.
dotnet_diagnostic.S6602.severity = none

# SECTION 13: COMPILER
# Only the shipped library surface is documented.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1570.severity = error
dotnet_diagnostic.CS1572.severity = error
dotnet_diagnostic.CS1573.severity = error
dotnet_diagnostic.CS1574.severity = error
dotnet_diagnostic.CS1587.severity = error

# Hand-written shipped library code documents every public member.
[src/SDL2.*/**.cs]
dotnet_diagnostic.CS1591.severity = error

# SECTION 14: GENERATED CODE
# Generated bindings retain their compiler, oracle, snapshot, ABI and drift gates.
[**/Generated/**.g.cs]
generated_code = true

[*.{g.cs,generated.cs,designer.cs}]
generated_code = true

# Vendored bindings keep their existing analyzer exclusion.
[external/sdl2-cs/src/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CA5392.severity = none

# SECTION 15: TEST OVERRIDES
[{build/_build.Tests,tests,spikes/binding-generators/clangsharp/tests}/**.cs]
# Test method names use underscores and their public surface is not shipped.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none
# TUnit assertion awaitables are not modeled by this analyzer.
dotnet_diagnostic.MA0042.severity = none
# Tests have no SynchronizationContext to preserve.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.VSTHRD111.severity = none
# Test namespaces are not a consumer-facing API.
dotnet_diagnostic.CA1716.severity = none

# QM-9: CA1515 stays at none until "build(analyzers): replace NoWarn lists, pragmas and SuppressMessage with fixes and arbitration".
[spikes/binding-generators/clangsharp/tests/**.cs]
dotnet_diagnostic.CA1515.severity = none

# FILE-SCOPED ARBITRATION
# Duplicate detection mutates the version map; filtering would hide that mutation in a predicate.
# Winner: explicit stateful validation; S3267 remains enabled for every other file.
[build/_build/Data/Versions/PackageFamilyVersionSet.cs]
dotnet_diagnostic.S3267.severity = none

# Git has no fixed install path across supported hosts; PATH selects it and --repo-root bypasses it.
# Winner: pre-Cake repository discovery; S4036 remains enabled for every other file.
[build/_build/Program.cs]
dotnet_diagnostic.S4036.severity = none

# Frozen generator tools retain their existing SDK analyzer behavior.
# Winner: generator toolchain freeze; CA1305, CA1307, CA1859, CA1861 and CA1865 remain enabled for every other file.
[spikes/binding-generators/clangsharp/{postprocess/**.cs,oracle.cs}]
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1861.severity = suggestion
dotnet_diagnostic.CA1865.severity = suggestion

# ABI assertions expose native widths through explicit declared types.
# Raw native memory is the subject of ABI tests.
# Winner: ABI width and memory visibility; IDE0007 and S6640 remain enabled elsewhere; IDE0008 cannot fire while var is preferred globally.
[spikes/binding-generators/clangsharp/tests/abi-tests/**.cs]
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.S6640.severity = none

# Generated interop is frozen byte-for-byte until the C# generator port, which owns the native search-path policy.
# Winner: the generator freeze; CA5392 remains enabled for every other file.
[spikes/binding-generators/clangsharp/src/*/Generated/**.cs]
dotnet_diagnostic.CA5392.severity = none

# OperatingSystem OS checks are unavailable on net462 until Polyfill reaches the spike projects.
# Winner: one source across TFMs; MA0144 remains enabled for every other file.
[spikes/binding-generators/clangsharp/tests/abi-tests/{Infrastructure/Sdl/Scopes/SdlEnvironmentScope.cs,Upstream/Pure/PlatformAbiTests.cs}]
dotnet_diagnostic.MA0144.severity = none

# Pointer elements cannot be LINQ type arguments; the loop frees what it filters.
# Winner: native pointer cleanup; S3267 remains enabled for every other file.
[spikes/binding-generators/clangsharp/tests/abi-tests/Upstream/Assets/SurfaceAbiTests.cs]
dotnet_diagnostic.S3267.severity = none
