dotnet_diagnostic.MA0111.severity = error
# QM-19: MA0048 stays at suggestion until "style: one type per file named after it (MA0048 error)".
dotnet_diagnostic.MA0048.severity = suggestion
dotnet_diagnostic.MA0052.severity = error
# QM-11: MA0053 stays at none until "style: collection expressions, sealing, and the remaining revived rules".
dotnet_diagnostic.MA0053.severity = none
dotnet_diagnostic.MA0067.severity = error
dotnet_diagnostic.MA0102.severity = error
dotnet_diagnostic.MA0110.severity = error
# CA rules own these duplicate checks.
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0180.severity = suggestion
# Explicit casts make native ABI conversions visible.
dotnet_diagnostic.MA0181.severity = none
dotnet_diagnostic.MA0182.severity = suggestion
dotnet_diagnostic.MA0183.severity = error
# QM-20: MA0184 stays at suggestion until "style: remaining revived rules".
dotnet_diagnostic.MA0184.severity = suggestion
# QM-20: MA0185 stays at suggestion until "style: remaining revived rules".
dotnet_diagnostic.MA0185.severity = suggestion
