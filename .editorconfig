dotnet_diagnostic.MA0194.severity = suggestion
dotnet_diagnostic.MA0195.severity = error
dotnet_diagnostic.MA0196.severity = error
# CS1591 owns the shipped-surface documentation policy.
dotnet_diagnostic.MA0197.severity = none
dotnet_diagnostic.MA0198.severity = error
dotnet_diagnostic.MA0199.severity = error
dotnet_diagnostic.MA0200.severity = suggestion
