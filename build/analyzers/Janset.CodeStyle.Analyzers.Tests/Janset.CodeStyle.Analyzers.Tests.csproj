<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ToolingTargetFramework)</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAOTAnalyzer>false</EnableAOTAnalyzer>
    <RootNamespace>Janset.CodeStyle.Analyzers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj" />
    <Compile Include="../../_build.Tests/Fixtures/CodeStyle/*.cs" Link="Fixtures/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
</Project>
