{
  "schema_version": "2.2",

  "packaging_config": {
    "validation_mode": "strict",
    "core_library": "sdl2"
  },

  "runtimes": [
    { "rid": "win-x64", "triplet": "x64-windows-hybrid", "runner": "windows-2025-vs2026", "container_image": null },
    { "rid": "win-arm64", "triplet": "arm64-windows-hybrid", "runner": "windows-11-arm", "container_image": null },
    { "rid": "win-x86", "triplet": "x86-windows-hybrid", "runner": "windows-2025-vs2026", "container_image": null },
    { "rid": "linux-x64", "triplet": "x64-linux-hybrid", "runner": "ubuntu-24.04", "container_image": "ghcr.io/janset2d/sdl2-bindings-linux-builder:focal-latest" },
    { "rid": "linux-arm64", "triplet": "arm64-linux-hybrid", "runner": "ubuntu-24.04-arm", "container_image": "ghcr.io/janset2d/sdl2-bindings-linux-builder:focal-latest" },
    { "rid": "osx-x64", "triplet": "x64-osx-hybrid", "runner": "macos-15-intel", "container_image": null },
    { "rid": "osx-arm64", "triplet": "arm64-osx-hybrid", "runner": "macos-26", "container_image": null }
  ],

  "package_families": [
    {
      "name": "sdl2-core",
      "tag_prefix": "sdl2-core",
      "managed_project": "src/SDL2.Core/SDL2.Core.csproj",
      "native_project": "src/native/SDL2.Core.Native/SDL2.Core.Native.csproj",
      "library_ref": "SDL2",
      "depends_on": [],
      "change_paths": [
        "src/SDL2.Core/**",
        "src/native/SDL2.Core.Native/**"
      ]
    },
    {
      "name": "sdl2-image",
      "tag_prefix": "sdl2-image",
      "managed_project": "src/SDL2.Image/SDL2.Image.csproj",
      "native_project": "src/native/SDL2.Image.Native/SDL2.Image.Native.csproj",
      "library_ref": "SDL2_image",
      "depends_on": ["sdl2-core"],
      "change_paths": [
        "src/SDL2.Image/**",
        "src/native/SDL2.Image.Native/**"
      ]
    },
    {
      "name": "sdl2-mixer",
      "tag_prefix": "sdl2-mixer",
      "managed_project": "src/SDL2.Mixer/SDL2.Mixer.csproj",
      "native_project": "src/native/SDL2.Mixer.Native/SDL2.Mixer.Native.csproj",
      "library_ref": "SDL2_mixer",
      "depends_on": ["sdl2-core"],
      "change_paths": [
        "src/SDL2.Mixer/**",
        "src/native/SDL2.Mixer.Native/**"
      ]
    },
    {
      "name": "sdl2-ttf",
      "tag_prefix": "sdl2-ttf",
      "managed_project": "src/SDL2.Ttf/SDL2.Ttf.csproj",
      "native_project": "src/native/SDL2.Ttf.Native/SDL2.Ttf.Native.csproj",
      "library_ref": "SDL2_ttf",
      "depends_on": ["sdl2-core"],
      "change_paths": [
        "src/SDL2.Ttf/**",
        "src/native/SDL2.Ttf.Native/**"
      ]
    },
    {
      "name": "sdl2-gfx",
      "tag_prefix": "sdl2-gfx",
      "managed_project": "src/SDL2.Gfx/SDL2.Gfx.csproj",
      "native_project": "src/native/SDL2.Gfx.Native/SDL2.Gfx.Native.csproj",
      "library_ref": "SDL2_gfx",
      "depends_on": ["sdl2-core"],
      "change_paths": [
        "src/SDL2.Gfx/**",
        "src/native/SDL2.Gfx.Native/**"
      ]
    }
  ],

  "system_exclusions": {
    "windows": {
      "system_dlls": [
        "kernel32.dll",
        "kernelbase.dll",
        "ntdll.dll",
        "user32.dll",
        "gdi32.dll",
        "winmm.dll",
        "imm32.dll",
        "advapi32.dll",
        "shell32.dll",
        "shlwapi.dll",
        "ole32.dll",
        "oleaut32.dll",
        "version.dll",
        "setupapi.dll",
        "winspool.dll",
        "comdlg32.dll",
        "comctl32.dll",
        "ws2_32.dll",
        "iphlpapi.dll",
        "crypt32.dll",
        "d3d9.dll",
        "d3d11.dll",
        "dxgi.dll",
        "ucrtbase.dll",
        "msvcp*.dll",
        "vcruntime*.dll",
        "api-ms-win-*.dll"
      ]
    },
    "linux": {
      "system_libraries": [
        "linux-vdso.so*",
        "ld-linux-*.so*",
        "libc.so*",
        "libm.so*",
        "libpthread.so*",
        "libdl.so*",
        "librt.so*",
        "libutil.so*",
        "libresolv.so*",
        "libnss_*.so*",
        "libstdc++.so*",
        "libgcc_s.so*",
        "libsystemd.so*",
        "libdbus-*.so*",
        "libexpat.so*",
        "libasound.so*",
        "libatopology.so*",
        "libcap.so*",
        "libpsx.so*",
        "liblzma.so*",
        "liblz4.so*",
        "libzstd.so*",
        "libblkid.so*",
        "libmount.so*",
        "libcrypt.so*",
        "libxcrypt.so*",
        "libowcrypt.so*"
      ]
    },
    "osx": {
      "system_libraries": [
        "libSystem.B.dylib",
        "libobjc.A.dylib",
        "CoreVideo.framework",
        "Cocoa.framework",
        "IOKit.framework",
        "ForceFeedback.framework",
        "Carbon.framework",
        "CoreAudio.framework",
        "AudioToolbox.framework",
        "AVFoundation.framework",
        "Foundation.framework",
        "GameController.framework",
        "Metal.framework",
        "QuartzCore.framework",
        "CoreHaptics.framework",
        "AppKit.framework",
        "CoreFoundation.framework",
        "CoreGraphics.framework",
        "CoreServices.framework"
      ]
    }
  },

  "library_manifests": [
    {
      "name": "SDL2",
      "vcpkg_name": "sdl2",
      "vcpkg_version": "2.32.10",
      "vcpkg_port_version": 0,
      "native_lib_name": "SDL2.Core.Native",
      "core_lib": true,
      "primary_binaries": [
        { "os": "Windows", "patterns": ["SDL2.dll"] },
        { "os": "Linux", "patterns": ["libSDL2*"] },
        { "os": "OSX", "patterns": ["libSDL2*.dylib"] }
      ],
      "binding_generation": {
        "enabled": true,
        "managed_namespace": "SDL2",
        "primary_class_name": "SDL",
        "platform_catalog": "sdl2-core",
        "owned_prefixes": ["SDL_", "SDLK_", "SDL_HINT_", "SDL_INIT_"],
        "parse_defines": [
          "SDL_DECLSPEC=",
          "SDL_DISABLE_IMMINTRIN_H=1",
          "SDL_DISABLE_MMINTRIN_H=1",
          "SDL_DISABLE_XMMINTRIN_H=1",
          "SDL_DISABLE_EMMINTRIN_H=1",
          "SDL_DISABLE_PMMINTRIN_H=1",
          "SDL_DISABLE_MM3DNOW_H=1",
          "SDL_DISABLE_LSX_H=1",
          "SDL_DISABLE_LASX_H=1",
          "SDL_DISABLE_ARM_NEON_H=1"
        ],
        "clang_args": ["-fdeclspec", "-U__has_builtin"],
        "header_set": {
          "include_dir_glob": "include/SDL2",
          "header_glob": "*.h",
          "excluded_headers": [
            "SDL.h",
            "begin_code.h",
            "close_code.h",
            "SDL_opengl.h",
            "SDL_opengl_glext.h",
            "SDL_opengles.h",
            "SDL_opengles2.h",
            "SDL_opengles2_gl2.h",
            "SDL_opengles2_gl2ext.h",
            "SDL_opengles2_gl2platform.h",
            "SDL_opengles2_khrplatform.h",
            "SDL_egl.h",
            "SDL_image.h",
            "SDL_mixer.h",
            "SDL_net.h",
            "SDL_ttf.h"
          ],
          "excluded_header_prefixes": ["SDL_test", "SDL2_"]
        },
        "excluded_functions": ["SDL_main", "SDL_DYNAPI_entry"],
        "required_functions": [
          { "name": "SDL_Init",          "return_type": "int",  "parameters": [{ "type": "uint", "name": "flags" }], "source_header": "SDL.h" },
          { "name": "SDL_InitSubSystem", "return_type": "int",  "parameters": [{ "type": "uint", "name": "flags" }], "source_header": "SDL.h" },
          { "name": "SDL_QuitSubSystem", "return_type": "void", "parameters": [{ "type": "uint", "name": "flags" }], "source_header": "SDL.h" },
          { "name": "SDL_WasInit",       "return_type": "uint", "parameters": [{ "type": "uint", "name": "flags" }], "source_header": "SDL.h" },
          { "name": "SDL_Quit",          "return_type": "void", "parameters": [],                                    "source_header": "SDL.h" }
        ],
        "required_constants": [
          { "name": "SDL_INIT_TIMER",          "type": "uint", "value": "0x00000001u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_AUDIO",          "type": "uint", "value": "0x00000010u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_VIDEO",          "type": "uint", "value": "0x00000020u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_JOYSTICK",       "type": "uint", "value": "0x00000200u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_HAPTIC",         "type": "uint", "value": "0x00001000u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_GAMECONTROLLER", "type": "uint", "value": "0x00002000u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_EVENTS",         "type": "uint", "value": "0x00004000u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_SENSOR",         "type": "uint", "value": "0x00008000u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_NOPARACHUTE",    "type": "uint", "value": "0x00100000u", "source_header": "SDL.h", "kind": "Literal" },
          { "name": "SDL_INIT_EVERYTHING",     "type": "uint", "value": "SDL_INIT_TIMER | SDL_INIT_AUDIO | SDL_INIT_VIDEO | SDL_INIT_EVENTS | SDL_INIT_JOYSTICK | SDL_INIT_HAPTIC | SDL_INIT_GAMECONTROLLER | SDL_INIT_SENSOR", "source_header": "SDL.h", "kind": "Computed" }
        ],
        "deferred_declarations": {
          "SDL_SysWMinfo": {
            "category": "deferred-to-stage-2",
            "reason": "SDL_syswm typed-union layout requires the platform-handle forward-declaration stub library (HWND/HDC/Display*/Window/etc.) and [StructLayout(LayoutKind.Explicit, Size = 64)] emission. Stage 1 emits SDL_GetWindowWMInfo with an opaque SDL_SysWMinfo* parameter; the typed union lands in Stage 2."
          },
          "SDL_SysWMmsg": {
            "category": "deferred-to-stage-2",
            "reason": "Same as SDL_SysWMinfo."
          },
          "SDL_DUMMY_ENUM": {
            "category": "internal-sdl-sentinel",
            "reason": "SDL_stdinc.h declares this under DOXYGEN_SHOULD_IGNORE_THIS only to assert enum size at compile time; it is not public binding API."
          }
        },
        "validators": {
          "dynapi-coherence": true,
          "neutral-view-non-empty": true,
          "required-functions-emitted": true,
          "semantic-type-consistency": true
        },
        "dynapi": {
          "exports_glob": "buildtrees/sdl2/src/*/src/dynapi/SDL2.exports"
        }
      }
    },
    {
      "name": "SDL2_image",
      "vcpkg_name": "sdl2-image",
      "vcpkg_version": "2.8.8",
      "vcpkg_port_version": 2,
      "native_lib_name": "SDL2.Image.Native",
      "core_lib": false,
      "primary_binaries": [
        { "os": "Windows", "patterns": ["SDL2_image.dll"] },
        { "os": "Linux", "patterns": ["libSDL2_image*"] },
        { "os": "OSX", "patterns": ["libSDL2_image*.dylib"] }
      ],
      "binding_generation": {
        "enabled": false,
        "_stage": "stage-2-placeholder",
        "managed_namespace": "SDL2.Image",
        "primary_class_name": "SDL_image",
        "platform_catalog": "sdl2-image",
        "owned_prefixes": ["IMG_"]
      }
    },
    {
      "name": "SDL2_mixer",
      "vcpkg_name": "sdl2-mixer",
      "vcpkg_version": "2.8.1",
      "vcpkg_port_version": 2,
      "native_lib_name": "SDL2.Mixer.Native",
      "core_lib": false,
      "primary_binaries": [
        { "os": "Windows", "patterns": ["SDL2_mixer.dll"] },
        { "os": "Linux", "patterns": ["libSDL2_mixer*"] },
        { "os": "OSX", "patterns": ["libSDL2_mixer*.dylib"] }
      ],
      "binding_generation": {
        "enabled": false,
        "_stage": "stage-2-placeholder",
        "managed_namespace": "SDL2.Mixer",
        "primary_class_name": "SDL_mixer",
        "platform_catalog": "sdl2-mixer",
        "owned_prefixes": ["Mix_"]
      }
    },
    {
      "name": "SDL2_ttf",
      "vcpkg_name": "sdl2-ttf",
      "vcpkg_version": "2.24.0",
      "vcpkg_port_version": 0,
      "native_lib_name": "SDL2.Ttf.Native",
      "core_lib": false,
      "primary_binaries": [
        { "os": "Windows", "patterns": ["SDL2_ttf.dll"] },
        { "os": "Linux", "patterns": ["libSDL2_ttf*"] },
        { "os": "OSX", "patterns": ["libSDL2_ttf*.dylib"] }
      ],
      "binding_generation": {
        "enabled": false,
        "_stage": "stage-2-placeholder",
        "managed_namespace": "SDL2.Ttf",
        "primary_class_name": "SDL_ttf",
        "platform_catalog": "sdl2-ttf",
        "owned_prefixes": ["TTF_"]
      }
    },
    {
      "name": "SDL2_gfx",
      "vcpkg_name": "sdl2-gfx",
      "vcpkg_version": "1.0.4",
      "vcpkg_port_version": 11,
      "native_lib_name": "SDL2.Gfx.Native",
      "core_lib": false,
      "primary_binaries": [
        { "os": "Windows", "patterns": ["SDL2_gfx.dll"] },
        { "os": "Linux", "patterns": ["libSDL2_gfx*"] },
        { "os": "OSX", "patterns": ["libSDL2_gfx*.dylib"] }
      ],
      "binding_generation": {
        "enabled": false,
        "_stage": "stage-2-placeholder",
        "managed_namespace": "SDL2.Gfx",
        "primary_class_name": "SDL2_gfx",
        "platform_catalog": "sdl2-gfx",
        "owned_prefixes": [
          "SDL2_gfx",
          "rotozoom",
          "boxColor",
          "lineColor",
          "pixelColor",
          "filledCircle",
          "circleRGBA",
          "stringColor",
          "characterColor",
          "FPSmanager"
        ]
      }
    }
  ]
}
