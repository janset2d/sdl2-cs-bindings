[
  "tool",
  "run",
  "ClangSharpPInvokeGenerator",
  "--config",
  "latest-codegen",
  "windows-types",
  "generate-macro-bindings",
  "@{REPO}/build/binding-generation/rsp/base.rsp",
  "@{REPO}/build/binding-generation/rsp/sdl2-core.rsp",
  "--methodClassName",
  "SDLNative",
  "--libraryPath",
  "SDL2",
  "--namespace",
  "SDL2",
  "--with-access-specifier",
  "SDLNative=Internal",
  "--include-directory",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2",
  "--file",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2/SDL_assert.h",
  "--output",
  "{REPO}/spikes/binding-generators/clangsharp/src/Janset.SDL2.Core/Generated/Modern/SDL_assert.g.cs"
]
