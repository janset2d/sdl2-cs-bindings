[
  "tool",
  "run",
  "ClangSharpPInvokeGenerator",
  "--config",
  "compatible-codegen",
  "windows-types",
  "generate-macro-bindings",
  "@{REPO}/build/binding-generation/rsp/base.rsp",
  "@{REPO}/build/binding-generation/rsp/sdl2-gfx.rsp",
  "--methodClassName",
  "SDL2_gfxNative",
  "--libraryPath",
  "SDL2_gfx",
  "--namespace",
  "SDL2.Gfx",
  "--with-access-specifier",
  "SDL2_gfxNative=Internal",
  "--include-directory",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2",
  "--file",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2/SDL2_framerate.h",
  "--output",
  "{REPO}/spikes/binding-generators/clangsharp/src/Janset.SDL2.Gfx/Generated/Compat/SDL2_framerate.g.cs"
]
