[
  "tool",
  "run",
  "ClangSharpPInvokeGenerator",
  "--config",
  "compatible-codegen",
  "windows-types",
  "generate-macro-bindings",
  "@{REPO}/build/binding-generation/rsp/base.rsp",
  "@{REPO}/build/binding-generation/rsp/sdl2-core.rsp",
  "--methodClassName",
  "SDLNative",
  "--libraryPath",
  "SDL2",
  "--namespace",
  "SDL2",
  "--with-access-specifier",
  "SDLNative=Internal",
  "--include-directory",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2",
  "--include-directory",
  "{REPO}/build/binding-generation/shims/platform-headers",
  "--file",
  "{REPO}/vcpkg_installed/x64-windows-hybrid/include/SDL2/SDL_main.h",
  "--output",
  "{REPO}/spikes/binding-generators/clangsharp/src/Janset.SDL2.Core/Generated/Compat/Platforms/WindowsDesktop/SDL_main.g.cs",
  "--define-macro",
  "_WIN32=1",
  "WIN32=1",
  "__WIN32__=1",
  "__WINDOWS__=1",
  "SDL_VIDEO_DRIVER_WINDOWS=1",
  "--additional=--undefine-macro=__WINRT__",
  "--additional=--undefine-macro=__GDK__",
  "--additional=--undefine-macro=__WINGDK__",
  "--additional=--undefine-macro=linux",
  "--additional=--undefine-macro=__linux",
  "--additional=--undefine-macro=__linux__",
  "--additional=--undefine-macro=__LINUX__",
  "--additional=--undefine-macro=__APPLE__",
  "--additional=--undefine-macro=__MACOSX__",
  "--additional=--undefine-macro=__IPHONEOS__",
  "--additional=--undefine-macro=__ANDROID__",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_WINRT",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_X11",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_WAYLAND",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_KMSDRM",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_COCOA",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_UIKIT",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_ANDROID",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_DIRECTFB",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_VIVANTE",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_MIR",
  "--additional=--undefine-macro=SDL_VIDEO_DRIVER_OS2",
  "--exclude",
  "SDL_main_func",
  "SDL_main",
  "SDL_SetMainReady"
]
