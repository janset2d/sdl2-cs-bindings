<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ToolingTargetFramework)</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Build.Tests</RootNamespace>
    <AssemblyName>Build.Tests</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAOTAnalyzer>false</EnableAOTAnalyzer>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    <SolutionDir>$(MSBuildProjectDirectory)\..\..\</SolutionDir>
    <SolutionName>Janset.SDL2</SolutionName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\_build\Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" PrivateAssets="all" />
    <PackageReference Include="Cake.Testing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Data\**\*.json" />
  </ItemGroup>

</Project>
