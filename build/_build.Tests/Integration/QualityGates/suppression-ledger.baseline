editorconfig .editorconfig [build/_build/Data/Versions/PackageFamilyVersionSet.cs] dotnet_diagnostic.S3267.severity = none | # Duplicate detection mutates the version map; filtering would hide that mutation in a predicate. # Winner: explicit stateful validation; S3267 remains enabled for every other file.
