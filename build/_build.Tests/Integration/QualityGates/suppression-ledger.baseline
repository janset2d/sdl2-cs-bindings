editorconfig .editorconfig [*.cs] dotnet_diagnostic.S2094.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.S2479.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.S3925.severity = none | # Exception serialization is obsolete on modern .NET.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.S4457.severity = suggestion | # SECTION 3: C# FORMATTING
