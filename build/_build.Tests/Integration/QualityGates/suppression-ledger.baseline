editorconfig .editorconfig [*.cs] dotnet_diagnostic.MA0041.severity = none | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.MA0180.severity = suggestion | # SECTION 3: C# FORMATTING
