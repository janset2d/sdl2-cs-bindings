editorconfig .editorconfig [*.cs] dotnet_diagnostic.IDE0032.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.IDE0290.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.MA0006.severity = suggestion
