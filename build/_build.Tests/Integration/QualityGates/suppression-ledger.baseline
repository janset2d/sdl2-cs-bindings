Suppression ledger: every diagnostic escape is counted.

build-switch: 41
editorconfig: 120
generated-code-attribute: 0
generated-code-header: 16
globalconfig: 0
msbuild-warnings-as-messages: 0
no-error: 0
no-warn: 1
nullable: 0
pragma: 0
slopwatch-baseline: 13
slopwatch-ignore: 3
slopwatch-suppress: 0
staging-marker: 0
suppress-message: 0
warnings-not-as-errors: 0

build-switch Directory.Build.props [ '$(TargetFramework)' != 'net462' And '$(TargetFramework)' != 'netstandard2.0' ] EnableAOTAnalyzer = true
build-switch Directory.Build.props [ '$(TargetFramework)' != 'net462' And '$(TargetFramework)' != 'netstandard2.0' ] IsAotCompatible = true
build-switch Directory.Build.props [ '$(TargetFramework)' != 'net462' And '$(TargetFramework)' != 'netstandard2.0' ] IsTrimmable = true
build-switch Directory.Build.props [!Exists('$(MSBuildThisFileDirectory).git')] EnableSourceControlManagerQueries = false
build-switch Directory.Build.props [!Exists('$(MSBuildThisFileDirectory).git')] EnableSourceLink = false
build-switch Directory.Build.props [] AnalysisLevel = 10.0
build-switch Directory.Build.props [] AnalysisMode = All
build-switch Directory.Build.props [] CodeAnalysisTreatWarningsAsErrors = true
build-switch Directory.Build.props [] EnableNETAnalyzers = true
build-switch Directory.Build.props [] EnforceCodeStyleInBuild = true
build-switch Directory.Build.props [] MSBuildTreatWarningsAsErrors = true
build-switch Directory.Build.props [] Nullable = enable
build-switch Directory.Build.props [] RunAnalyzersDuringBuild = true
build-switch Directory.Build.props [] RunAnalyzersDuringLiveAnalysis = true
build-switch Directory.Build.props [] TreatWarningsAsErrors = true
build-switch build/_build.Tests/Build.Tests.csproj [] EnableAOTAnalyzer = false
build-switch build/_build.Tests/Build.Tests.csproj [] IsAotCompatible = false
build-switch build/_build.Tests/Build.Tests.csproj [] IsTrimmable = false
build-switch build/_build/Build.csproj [] EnableAOTAnalyzer = false
build-switch build/_build/Build.csproj [] IsAotCompatible = false
build-switch build/_build/Build.csproj [] IsTrimmable = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] EnableAOTAnalyzer = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] IsAotCompatible = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] IsTrimmable = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] EnableAOTAnalyzer = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] IsAotCompatible = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] IsTrimmable = false
build-switch build/msbuild/Janset.Smoke.props [Exists('$(MSBuildThisFileDirectory)Janset.Local.props')] Import = $(MSBuildThisFileDirectory)Janset.Local.props
build-switch build/msbuild/Janset.Smoke.props [] EnableAOTAnalyzer = false
build-switch build/msbuild/Janset.Smoke.props [] IsAotCompatible = false
build-switch build/msbuild/Janset.Smoke.props [] IsTrimmable = false
build-switch spikes/binding-generators/Directory.Build.props [ '$(MSBuildProjectName)' != 'Janset.SDL2.PostProcess' And '$(MSBuildProjectName)' != 'oracle.cs' ] Import = $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))
build-switch spikes/binding-generators/Directory.Build.props [ '$(MSBuildProjectName)' == 'Janset.SDL2.PostProcess' Or '$(MSBuildProjectName)' == 'oracle.cs' ] Nullable = enable
build-switch spikes/binding-generators/Directory.Build.props [ '$(MSBuildProjectName)' == 'Janset.SDL2.PostProcess' Or '$(MSBuildProjectName)' == 'oracle.cs' ] TreatWarningsAsErrors = true
build-switch spikes/binding-generators/clangsharp/postprocess/Janset.SDL2.PostProcess.csproj [] Nullable = enable
build-switch src/native/Directory.Build.props [] EnableAOTAnalyzer = false
build-switch src/native/Directory.Build.props [] EnableNETAnalyzers = false
build-switch src/native/Directory.Build.props [] IsAotCompatible = false
build-switch src/native/Directory.Build.props [] IsTrimmable = false
build-switch src/native/Directory.Build.props [] RunAnalyzersDuringBuild = false
build-switch tests/smoke-tests/Directory.Build.targets ['$([MSBuild]::GetPathOfFileAbove(Directory.Build.targets, $(MSBuildThisFileDirectory)../))' != ''] Import = $([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))
editorconfig .editorconfig [**/Generated/**.g.cs] generated_code = true | # SECTION 14: GENERATED CODE # Generated bindings retain their compiler, oracle, snapshot, ABI and drift gates.
editorconfig .editorconfig [*.cs] MA0004.report = Always | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] MA0011.exclude_tostring_methods = true | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] MA0051.maximum_lines_per_method = 80 | # SECTION 10: MEZIANTOU
editorconfig .editorconfig [*.cs] MA0051.maximum_statements_per_method = 60 | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] MA0053.public_class_should_be_sealed = true | # Virtual members mark inheritance-by-design, so only the public-class option is enabled.
editorconfig .editorconfig [*.cs] csharp_prefer_simple_using_statement = true:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_accessors = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_constructors = false:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_indexers = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_lambdas = true:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_methods = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_operators = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_properties = when_on_single_line:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_prefer_extended_property_pattern = true:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_prefer_pattern_matching = true:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] csharp_style_prefer_switch_expression = true:suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_analyzer_diagnostic.category-roslynator.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_code_quality.CA1822.api_surface = private, internal | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1031.severity = none | # Boundary orchestration catches broadly to report failures.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1040.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1054.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1055.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1056.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1308.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1515.severity = none | # [opinionated] Public tooling types need no consumer-facing internalization policy.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1812.severity = suggestion | # Reflection and dependency injection instantiate types outside the compiler call graph.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1819.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1848.severity = none | # Structured logging templates stay readable at their call sites.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CS1591.severity = none | # SECTION 13: COMPILER # Only the shipped library surface is documented.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.IDE0032.severity = suggestion | # SECTION 3: C# FORMATTING
editorconfig .editorconfig [*.cs] dotnet_diagnostic.IDE0290.severity = suggestion | # SECTION 3: C# FORMATTING
