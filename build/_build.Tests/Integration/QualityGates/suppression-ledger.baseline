Suppression ledger: every diagnostic escape is counted.
Every conditional import and explicit Slopwatch severity assignment is inventoried.
Scans tracked C#, project XML, analyzer configs, Slopwatch files and workflows.
Does not scan rsp files, Dockerfiles or analyzer-config items.

build-switch: 49
editorconfig: 121
generated-code-attribute: 0
generated-code-header: 16
globalconfig: 0
msbuild-warnings-as-messages: 0
no-error: 0
no-warn: 1
nullable: 0
pragma: 0
slopwatch: 14
slopwatch-baseline: 13
slopwatch-ignore: 3
slopwatch-suppress: 0
staging-marker: 0
suppress-message: 0
warnings-not-as-errors: 0

build-switch .github/workflows/build-cake-host.yml [command line] RunAnalyzers = ${{ inputs.run-analyzers }} x2
build-switch Directory.Build.props [!Exists('$(MSBuildThisFileDirectory).git')] EnableSourceControlManagerQueries = false
build-switch Directory.Build.props [!Exists('$(MSBuildThisFileDirectory).git')] EnableSourceLink = false
build-switch Directory.Build.props ['$(TargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'] EnableAOTAnalyzer = true
build-switch Directory.Build.props ['$(TargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'] IsAotCompatible = true
build-switch Directory.Build.props ['$(TargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'] IsTrimmable = true
build-switch Directory.Build.props [] AnalysisLevel = 10.0
build-switch Directory.Build.props [] AnalysisMode = All
build-switch Directory.Build.props [] CodeAnalysisTreatWarningsAsErrors = true
build-switch Directory.Build.props [] EnableNETAnalyzers = true
build-switch Directory.Build.props [] EnforceCodeStyleInBuild = true
build-switch Directory.Build.props [] MSBuildTreatWarningsAsErrors = true
build-switch Directory.Build.props [] Nullable = enable
build-switch Directory.Build.props [] RunAnalyzersDuringBuild = true
build-switch Directory.Build.props [] RunAnalyzersDuringLiveAnalysis = true
build-switch Directory.Build.props [] TreatWarningsAsErrors = true
build-switch build/_build.Tests/Build.Tests.csproj [] EnableAOTAnalyzer = false
build-switch build/_build.Tests/Build.Tests.csproj [] IsAotCompatible = false
build-switch build/_build.Tests/Build.Tests.csproj [] IsTrimmable = false
build-switch build/_build/Build.csproj [] EnableAOTAnalyzer = false
build-switch build/_build/Build.csproj [] IsAotCompatible = false
build-switch build/_build/Build.csproj [] IsTrimmable = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] EnableAOTAnalyzer = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] IsAotCompatible = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers.Tests/Janset.CodeStyle.Analyzers.Tests.csproj [] IsTrimmable = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] EnableAOTAnalyzer = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] IsAotCompatible = false
build-switch build/analyzers/Janset.CodeStyle.Analyzers/Janset.CodeStyle.Analyzers.csproj [] IsTrimmable = false
build-switch build/msbuild/Janset.Smoke.props [Exists('$(MSBuildThisFileDirectory)Janset.Local.props')] Import = $(MSBuildThisFileDirectory)Janset.Local.props | `tools setup` local override: if present, injects LocalPackageFeed and per-family version properties so smoke / sample / AST-test / sandbox projects restore in IDE without a Cake-side explicit-version invocation. Runner-driven paths (Cake PackageConsumerSmokeRunner) thread versions via -p: overrides directly and ignore this file — Cake's strict explicit-version contract stays the single source of truth for stage-runner invocations.
build-switch build/msbuild/Janset.Smoke.props [] EnableAOTAnalyzer = false
build-switch build/msbuild/Janset.Smoke.props [] IsAotCompatible = false
build-switch build/msbuild/Janset.Smoke.props [] IsTrimmable = false
build-switch spikes/binding-generators/Directory.Build.props ['$(MSBuildProjectName)' != 'Janset.SDL2.PostProcess' And '$(MSBuildProjectName)' != 'oracle.cs'] Import = $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')) | Postprocess and the oracle keep their own build settings until they move into build/_build.
build-switch spikes/binding-generators/Directory.Build.props ['$(MSBuildProjectName)' == 'Janset.SDL2.PostProcess' Or '$(MSBuildProjectName)' == 'oracle.cs'] Nullable = enable
build-switch spikes/binding-generators/Directory.Build.props ['$(MSBuildProjectName)' == 'Janset.SDL2.PostProcess' Or '$(MSBuildProjectName)' == 'oracle.cs'] TreatWarningsAsErrors = true
build-switch spikes/binding-generators/clangsharp/postprocess/Janset.SDL2.PostProcess.csproj [] Nullable = enable
build-switch spikes/binding-generators/clangsharp/tests/api-snapshot/ApiSnapshot.csproj [] EnableAOTAnalyzer = false
build-switch spikes/binding-generators/clangsharp/tests/api-snapshot/ApiSnapshot.csproj [] IsAotCompatible = false
build-switch spikes/binding-generators/clangsharp/tests/api-snapshot/ApiSnapshot.csproj [] IsTrimmable = false
build-switch src/native/Directory.Build.props [] EnableAOTAnalyzer = false
build-switch src/native/Directory.Build.props [] EnableNETAnalyzers = false
build-switch src/native/Directory.Build.props [] IsAotCompatible = false
build-switch src/native/Directory.Build.props [] IsTrimmable = false
build-switch src/native/Directory.Build.props [] RunAnalyzersDuringBuild = false
build-switch tests/smoke-tests/Directory.Build.targets ['$([MSBuild]::GetPathOfFileAbove(Directory.Build.targets, $(MSBuildThisFileDirectory)../))' != ''] Import = $([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))
build-switch tools.cs [file-based header] EnableAOTAnalyzer = false
build-switch tools.cs [file-based header] IsAotCompatible = false
build-switch tools.cs [file-based header] IsTrimmable = false
editorconfig .editorconfig [**/Generated/**.g.cs] generated_code = true | # Generated bindings retain their compiler, oracle, snapshot, ABI and drift gates.
editorconfig .editorconfig [*.cs] MA0004.report = Always
editorconfig .editorconfig [*.cs] MA0011.exclude_tostring_methods = true
editorconfig .editorconfig [*.cs] MA0051.maximum_lines_per_method = 80
editorconfig .editorconfig [*.cs] MA0051.maximum_statements_per_method = 60
editorconfig .editorconfig [*.cs] MA0053.public_class_should_be_sealed = true | # Virtual members mark inheritance-by-design, so only the public-class option is enabled.
editorconfig .editorconfig [*.cs] csharp_prefer_simple_using_statement = true:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_constructors = false:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_lambdas = true:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_methods = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_operators = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_expression_bodied_properties = when_on_single_line:suggestion
editorconfig .editorconfig [*.cs] csharp_style_prefer_extended_property_pattern = true:suggestion
editorconfig .editorconfig [*.cs] csharp_style_prefer_pattern_matching = true:suggestion
editorconfig .editorconfig [*.cs] csharp_style_prefer_switch_expression = true:suggestion
editorconfig .editorconfig [*.cs] dotnet_analyzer_diagnostic.category-roslynator.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_code_quality.CA1822.api_surface = private, internal
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1031.severity = none | # Catch-general-exception: active rule, deliberately off [opinionated] - boundary orchestration reports failures.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1040.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1054.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1055.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1056.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1308.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1515.severity = none | # [opinionated] Public tooling types need no consumer-facing internalization policy.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1812.severity = suggestion | # Reflection and dependency injection instantiate types outside the compiler call graph.
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1819.severity = suggestion
editorconfig .editorconfig [*.cs] dotnet_diagnostic.CA1848.severity = none | # Structured logging templates stay readable at their call sites.
