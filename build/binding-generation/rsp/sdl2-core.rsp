# SDL2.Core enum underlying type. SDL2 distinguishes the enum tag
# SDL_PixelFormatEnum from the SDL_PixelFormat struct (Uint32 typedef in SDL2,
# vs collapsed enum in SDL3 — ppy's `SDL_PixelFormat=uint` RSP would break SDL2).
--with-type
SDL_PixelFormatEnum=uint

# SDL_GetWindowWMInfo needs an unproven platform-specific union layout.
# SDL_RWFromFP needs a portable C FILE mapping. SDL_DUMMY_ENUM is a compiler
# size check, not API. SDL_LogMessageV, SDL_vsnprintf, SDL_vsscanf and
# SDL_vasprintf take va_list, which has no portable C# P/Invoke mapping.
# Opaque stubs used by event pointers remain generated; only the function
# exposing the unproven union layout is deferred.
--exclude
SDL_GetWindowWMInfo
SDL_RWFromFP
SDL_DUMMY_ENUM
SDL_LogMessageV
SDL_vsnprintf
SDL_vsscanf
SDL_vasprintf

# SDL_assert.h — compiler-magic macros (__FUNCTION__ / __FILE__ / __LINE__
# expansions are unrepresentable in portable C#) and assert-family helpers
# that have no public binding meaning.
SDL_FUNCTION
SDL_FILE
SDL_LINE
SDL_NULL_WHILE_LOOP_CONDITION
SDL_ASSERT_LEVEL

# Old type-name aliases of SDL_AssertState, SDL_AssertData and SDL_Color,
# which already bind. C# has no exported type alias.
SDL_assert_state
SDL_assert_data
SDL_Colour

# SDL_endian.h — compiler-feature checks for inline swap helpers, not API.
HAS_BUILTIN_BSWAP16
HAS_BUILTIN_BSWAP32
HAS_BUILTIN_BSWAP64

# SDL_stdinc.h — SDL_size_mul_overflow and SDL_size_add_overflow are inline
# helpers whose bodies depend on target size limits. SDL_SIZE_MAX and the
# SDL_PRIs64 / SDL_PRIu64 / SDL_PRIx64 / SDL_PRIX64 format strings depend on
# the compiler or target ABI, not portable public values. SDL_memset4 and
# SDL_memcpy4 are inline implementations, not native imports. The two
# _SDL_size_*_overflow_builtin wrappers call compiler builtins with no C# meaning.
SDL_size_mul_overflow
SDL_size_add_overflow
SDL_SIZE_MAX
SDL_PRIs64
SDL_PRIu64
SDL_PRIx64
SDL_PRIX64
SDL_memset4
SDL_memcpy4
_SDL_size_mul_overflow_builtin
_SDL_size_add_overflow_builtin

# SDL_endian.h — SDL_SwapFloat is an inline union-based byte-swap helper.
# Translating its body leaves a compiler-intrinsic call, not a portable C# operation.
# Public byte-order constants remain generated.
SDL_SwapFloat

# SDL_bits.h — inline MSVC-intrinsic helpers. No public binding API needed
# from this header; consumers can use System.Numerics.BitOperations.
SDL_MostSignificantBitIndex32
SDL_HasExactlyOneBitSet32

# SDL_cpuinfo.h — SDL_CACHELINE_SIZE is a fixed 128-byte padding guess for C
# struct layout, not the host's cache line size, which SDL_GetCPUCacheLineSize
# returns at runtime.
SDL_CACHELINE_SIZE

# SDL_thread.h — SDL_CreateThread and SDL_CreateThreadWithStackSize have
# platform-divergent signatures: Windows and GDK exports take the caller's
# CRT begin/end thread functions; other platforms have a shorter signature.
# SDL_beginthread / SDL_endthread are macro aliases that ClangSharp emits
# as function-pointer assignments to the caller's CRT functions.
SDL_CreateThread
SDL_CreateThreadWithStackSize
SDL_beginthread
SDL_endthread

# Function-pointer macro aliases that ClangSharp emits as
# `public static readonly IntPtr X = &Func;` — fine on net5+ but unmappable
# on netstandard2.0/net462 (CS8812: can't convert &method group to IntPtr).
# These are #define shortcuts; consumers can call the underlying function
# directly.
SDL_BlitSurface
SDL_BlitScaled

# SDL_main.h — `#define main SDL_main` alias that ClangSharp expands into
# `public static readonly IntPtr main = &SDL_main;` and which causes the
# same CS8812 on legacy TFMs. SDL_main itself stays generated.
main
