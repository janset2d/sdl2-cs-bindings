# Per-header overrides for SDL_vulkan.h.
#
# VkInstance / VkSurfaceKHR are owned by the user's external Vulkan binding
# (Silk.NET.Vulkan, Vortice.Vulkan, TerraFX). SDL2 references them in
# SDL_Vulkan_CreateSurface parameters.
# Emit as nint / nint* so users pass handle values from external Vulkan
# bindings directly without explicit-conversion friction.
#
# Precedent: SDL2-CS uses IntPtr for VkInstance and `out ulong` for
# VkSurfaceKHR. We use `nint` to match the other foreign pointer mappings.
# `nint` is a C# language alias for System.IntPtr -- IL is
# identical, only the generated source spelling differs.
#
# Match the typedef names, not a pointer spelling. ClangSharp's pointer-suffix
# handling turns VkSurfaceKHR* into nint* after remapping VkSurfaceKHR to nint.
# This avoids the pointer-spelling mismatch seen with a quoted, spaced key.

--remap
VkInstance=nint
VkSurfaceKHR=nint

--exclude
VkInstance_T
VkSurfaceKHR_T
