# Per-header RSP for SDL_surface.h.
#
# SDL_BlitMap (line 64 of SDL_surface.h): /* this is an opaque type. */
#   Field-scope only at SDL_Surface.map (private). No public API consumes or
#   returns SDL_BlitMap*. SDL3 removed it entirely (void* reserved).
#
# A private field-only opaque pointer needs no public handle wrapper:
#   --exclude SDL_BlitMap : drop the empty struct emit entirely
#   --remap SDL_BlitMap*=nint : SDL_Surface.map field type becomes nint
#
# Remap-key spelling note: libclang renders pointer-to-tag types without a
# space (canonical form `SDL_BlitMap*`), whereas pointer-to-builtin types
# render with a space (`wchar_t *`). Verified by regeneration with ClangSharp
# 23.1.5 — output carries the field as
# `[NativeTypeName("SDL_BlitMap*")] public nint map;`. The `void*=nint`
# entry likewise uses a no-space pointer spelling.
#
# Peer evidence: SDL2-CS, Chroma-2D, flibit-SDL3 all use `IntPtr map`.

--exclude
SDL_BlitMap

--remap
SDL_BlitMap*=nint
