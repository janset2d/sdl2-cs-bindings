<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike-only binding library — output of ClangSharpPInvokeGenerator over SDL2_gfx headers.
    Not part of the canonical build; lives under tools/binding-spike/ on a temp branch.
    Throwaway artifact unless promoted to production after spike review.

    Imports root Directory.Build.props through the SDK chain; the props file forces multi-TFM
    library defaults + repo-wide analyzers. For spike we want single-TFM + relaxed analyzers
    so the generated file's idiomatic-but-not-perfect output doesn't hit TreatWarningsAsErrors.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Janset.Spike.SDL2.Gfx</RootNamespace>
    <AssemblyName>Janset.Spike.SDL2.Gfx</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Spike: don't fail on the relaxed shape generated code starts with. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591;CS8500;CA1707;CA1716;CA2101;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <!-- SDK default Compile glob picks up Generated/*.g.cs + NativeTypeNameAttribute.cs automatically. -->

</Project>
