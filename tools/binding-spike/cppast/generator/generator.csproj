<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike-only console generator. Custom CppAst-based emitter for SDL2_gfx.
    Throwaway artifact on spike branch.

    Root Directory.Build.props inherits multi-TFM defaults; CppAst only ships net8+
    so we explicitly clear $(TargetFrameworks) (plural) and pin $(TargetFramework)
    (singular). Without the explicit clear, MSBuild prefers plural and fails restore.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Spike: relax analyzers + warnings-as-errors so iteration is fast. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591;CS8500;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CppAst" />
    <PackageReference Include="libclang.runtime.win-x64" />
    <PackageReference Include="libClangSharp.runtime.win-x64" />
  </ItemGroup>

</Project>
