<Project>
  <ItemGroup>
    <!-- third-party analyzers -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.339" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <!-- packages -->
    <PackageVersion Include="Cake.CMake" Version="1.4.0" />
    <PackageVersion Include="Cake.Frosting" Version="7.0.0" />
    <!-- Cake.Frosting.Git: used by PackagePipeline for GitLogTip HEAD-SHA stamping (G55 native metadata). -->
    <PackageVersion Include="Cake.Frosting.Git" Version="5.0.1" />
    <!-- Referenced only by the file-based tools.cs. -->
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <!-- Lifts NuGet.Packaging's vulnerable Pkcs 8.0.1 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
         Remove with the transitive pinning switch once NuGet.Packaging depends on a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- test packages -->
    <PackageVersion Include="Cake.Testing" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="TUnit" Version="1.81.16" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
  </ItemGroup>
</Project>
