<Project>
  <ItemGroup>
    <!-- third-party analyzers -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.321" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <!-- packages -->
    <PackageVersion Include="Cake.CMake" Version="1.4.0" />
    <PackageVersion Include="Cake.Frosting" Version="6.3.0" />
    <!-- Cake.Frosting.Git: used by PackagePipeline for GitLogTip HEAD-SHA stamping (G55 native metadata). -->
    <PackageVersion Include="Cake.Frosting.Git" Version="5.0.1" />
    <!-- Referenced only by the file-based tools.cs. -->
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="PolySharp" Version="1.15.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.CommandLine.NamingConventionBinder" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <!-- Polyfill for System.Runtime.InteropServices.RuntimeInformation on net462.
         Used by the SDL_ThreadID dual-dispatch wrapper (Slice C-A R2 structural emit)
         to select between Windows (uint) and Unix LP64 (nint) DllImport pairs. -->
    <PackageVersion Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <!-- Lifts Cake.Frosting's vulnerable Pkcs 10.0.3 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7).
         Remove with the transitive pinning switch once Cake.Frosting depends on Pkcs >= 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- test packages -->
    <PackageVersion Include="Cake.Testing" Version="6.3.0" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Condition="'$(TargetFramework)' == 'net462'" Version="17.11.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="TUnit" Version="1.81.16" />
    <PackageVersion Include="Verify.TUnit" Version="31.16.3" />
  </ItemGroup>
</Project>
