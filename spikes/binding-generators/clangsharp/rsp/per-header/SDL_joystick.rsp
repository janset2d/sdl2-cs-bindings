# Per-header overrides for SDL_joystick.h.
#
# R6 tag/typedef canonicalization (Constitution section "Opaque Handles"): rename the
# private C struct tag `_SDL_Joystick` to the public typedef name
# `SDL_Joystick` everywhere (struct declaration + every reference).

--remap
_SDL_Joystick=SDL_Joystick
