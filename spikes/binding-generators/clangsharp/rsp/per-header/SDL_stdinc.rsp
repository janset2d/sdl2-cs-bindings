# Per-header overrides for SDL_stdinc.h.
#
# R6 tag/typedef canonicalization (Constitution section "Opaque Handles"):
# rename the private C struct tag `_SDL_iconv_t` to the public typedef
# name `SDL_iconv_t` everywhere.

--remap
_SDL_iconv_t=SDL_iconv_t

# BCL-Replaceable Helper Exclusion Policy (Constitution section
# "BCL-Replaceable Helper Exclusion Policy"). A symbol/family is
# excluded when (1) a BCL equivalent exists with equal-or-better
# ergonomics, (2) SDL2-CS does not expose it, (3) no other SDL2
# symbol transitively depends on it.
#
# R2 C long convenience helpers — drop all-TFM per SDL2-CS precedent
# (also referenced by Constitution section "C `long` And `unsigned long`"
# Priority C strategy; design Decision 2). SDL provides these for
# embedded platforms with incomplete libc; .NET callers have BCL
# equivalents:
#   SDL_lround/lroundf -> Math.Round / MathF.Round
#   SDL_ltoa/ultoa     -> value.ToString()
#   SDL_strtol/strtoul -> long.Parse / ulong.Parse
# SDL2 wiki does not document them as user-facing API; SDL2-CS has
# shipped this posture for 10+ years.
#
# SDL_iconv_* family — drop all-TFM. BCL equivalent: System.Text.Encoding
# (Encoding.GetEncoding / Encoding.Convert). SDL2-CS and Silk.NET both
# skip the entire family. With no function consuming SDL_iconv_t after
# these excludes, the empty struct typedef becomes harmless residue
# (Constitution Non-rule). The residue is documented in the roster
# JSON's excluded_candidates field.

--exclude
SDL_lround
SDL_lroundf
SDL_ltoa
SDL_ultoa
SDL_strtol
SDL_strtoul
SDL_iconv_open
SDL_iconv_close
SDL_iconv
SDL_iconv_string
