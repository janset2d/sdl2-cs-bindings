--define-macro
SDL_DECLSPEC=
SDL_DISABLE_IMMINTRIN_H=1
SDL_DISABLE_MMINTRIN_H=1
SDL_DISABLE_XMMINTRIN_H=1
SDL_DISABLE_EMMINTRIN_H=1
SDL_DISABLE_PMMINTRIN_H=1
SDL_DISABLE_MM3DNOW_H=1
SDL_DISABLE_LSX_H=1
SDL_DISABLE_LASX_H=1
SDL_DISABLE_ARM_NEON_H=1
SDL_SLOW_MEMCPY
SDL_SLOW_MEMMOVE
SDL_SLOW_MEMSET
SDL_DISABLE_ALLOCA

--remap
void*=nint
char=byte
wchar_t*=nint
Sint8=sbyte
Uint8=byte
Sint16=short
Uint16=ushort
Sint32=int
Uint32=uint
Sint64=long
Uint64=ulong

--with-type
SDL_bool=int

--additional
--undefine-macro=__has_builtin
-fdeclspec
